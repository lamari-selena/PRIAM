{
  "_comment": "PRIAM metadata for Ghostfolio. Load into PRIAM Data & Processing service via POST /api/data and POST /api/processing/create.",

  "dataAttributes": [
    {
      "dataName": "accessToken",
      "source": "DIRECT",
      "sourceDetails": "User table, column accessToken",
      "dataConservationDuration": 365,
      "isPersonal": true,
      "isPortable": false,
      "dataTypeName": "User",
      "personalDataCategoryName": "identification"
    },
    {
      "dataName": "thirdPartyId",
      "source": "INDIRECT",
      "sourceDetails": "User table, column thirdPartyId — OAuth provider identifier",
      "dataConservationDuration": 365,
      "isPersonal": true,
      "isPortable": false,
      "dataTypeName": "User",
      "personalDataCategoryName": "identification"
    },
    {
      "dataName": "name",
      "source": "DIRECT",
      "sourceDetails": "Account table, column name",
      "dataConservationDuration": 730,
      "isPersonal": true,
      "isPortable": true,
      "dataTypeName": "Account",
      "personalDataCategoryName": "profile"
    },
    {
      "dataName": "balance",
      "source": "DIRECT",
      "sourceDetails": "Account table, column balance",
      "dataConservationDuration": 3650,
      "isPersonal": true,
      "isPortable": true,
      "dataTypeName": "Account",
      "personalDataCategoryName": "financial"
    },
    {
      "dataName": "unitPrice",
      "source": "DIRECT",
      "sourceDetails": "Order table, column unitPrice — purchase/sale price of a financial instrument",
      "dataConservationDuration": 3650,
      "isPersonal": true,
      "isPortable": true,
      "dataTypeName": "Order",
      "personalDataCategoryName": "financial"
    },
    {
      "dataName": "quantity",
      "source": "DIRECT",
      "sourceDetails": "Order table, column quantity",
      "dataConservationDuration": 3650,
      "isPersonal": true,
      "isPortable": true,
      "dataTypeName": "Order",
      "personalDataCategoryName": "financial"
    },
    {
      "dataName": "fee",
      "source": "DIRECT",
      "sourceDetails": "Order table, column fee",
      "dataConservationDuration": 3650,
      "isPersonal": true,
      "isPortable": true,
      "dataTypeName": "Order",
      "personalDataCategoryName": "financial"
    },
    {
      "dataName": "comment",
      "source": "DIRECT",
      "sourceDetails": "Order table, column comment — free-text annotation on a transaction",
      "dataConservationDuration": 730,
      "isPersonal": true,
      "isPortable": true,
      "dataTypeName": "Order",
      "personalDataCategoryName": "profile"
    }
  ],

  "processings": [
    {
      "processingName": "portfolio-management",
      "processingType": "NECESSARY",
      "processingCategory": "CONTRACT",
      "consequence": "Without this processing, the portfolio tracking service cannot function.",
      "purposes": [
        {
          "purposeDescription": "Store and display user investment portfolio: accounts, transactions, balances.",
          "purposeType": "PRIMARY"
        }
      ],
      "dataUsages": [
        { "dataName": "name",      "c": true,  "r": true,  "u": true,  "d": true,  "personalStatus": true },
        { "dataName": "balance",   "c": true,  "r": true,  "u": true,  "d": false, "personalStatus": true },
        { "dataName": "unitPrice", "c": true,  "r": true,  "u": true,  "d": true,  "personalStatus": true },
        { "dataName": "quantity",  "c": true,  "r": true,  "u": true,  "d": true,  "personalStatus": true },
        { "dataName": "fee",       "c": true,  "r": true,  "u": true,  "d": false, "personalStatus": true }
      ]
    },
    {
      "processingName": "portfolio-ai-analysis",
      "processingType": "OPTIONAL",
      "processingCategory": "CONSENT",
      "consequence": "Refusing consent disables AI-powered portfolio analysis. Core portfolio tracking is unaffected.",
      "purposes": [
        {
          "purposeDescription": "Send portfolio holdings to an external AI service (OpenRouter LLM) to generate personalised financial analysis and insights.",
          "purposeType": "SECONDARY"
        }
      ],
      "dataUsages": [
        { "dataName": "name",      "c": false, "r": true,  "u": false, "d": false, "personalStatus": true },
        { "dataName": "unitPrice", "c": false, "r": true,  "u": false, "d": false, "personalStatus": true },
        { "dataName": "quantity",  "c": false, "r": true,  "u": false, "d": false, "personalStatus": true }
      ]
    },
    {
      "processingName": "activity-analytics",
      "processingType": "OPTIONAL",
      "processingCategory": "CONSENT",
      "consequence": "Refusing consent stops usage analytics collection. No impact on portfolio features.",
      "purposes": [
        {
          "purposeDescription": "Track user activity count, timezone/country, and request frequency to improve the platform.",
          "purposeType": "SECONDARY"
        }
      ],
      "dataUsages": [
        { "dataName": "thirdPartyId", "c": false, "r": true, "u": false, "d": false, "personalStatus": true }
      ]
    }
  ]
}
