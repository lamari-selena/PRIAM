{
  "compilerOptions": {

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": "src",
    "outDir": "dist",
    "sourceMap": true,
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
                               /* Skip type checking all .d.ts files. */
  },
  "include": ["src/**/*"]
}
