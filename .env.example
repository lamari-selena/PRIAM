# PRIAM generic configuration template.
#
# Copy this file to `.env` (same directory) before running
# `docker compose up`. Every value below is either a fixed, generic default
# (works out of the box, no target application required) or an empty
# placeholder meant to be filled in once you integrate a real target
# application - see Docs/PRIAM-INTEGRATION-PLAYBOOK.md.

# --- MySQL (must match Databases/Dockerfile's ENV defaults) ---
DB_USERNAME=priamu
DB_PASSWORD=MaiRP_pWd-UsEr
DB_HOST=mysqldb
DB_PORT=3306

GATEWAY_PORT=8090

# --- Provider bridge (playbook §2) ---
# Defaults to PRIAM's own generic Provider-microservice (a working, but
# empty, no-op bridge - useful to bring the stack up standalone). Point this
# directly at your target application's own Provider bridge implementation
# once written (e.g. http://<target-app-service>:<port>).
CUSTOM_PROVIDER_URL=http://provider:8086

# --- Internal service addresses (fixed, do not change) ---
CUSTOM_DATA_URL=http://data:8081
CUSTOM_ACTOR_URL=http://actor:8082
CUSTOM_RIGHT_URL=http://right:8083
CUSTOM_CDP_URL=http://consent:8089
CUSTOM_EUREKA_URL=http://eureka:8761

# --- OIDC / Gateway authentication (Docs/PRIAM-AUTH-OIDC.md) ---
# Empty = fail-open: the Gateway starts unauthenticated, every route is
# open (documented default, not an oversight). Fill in once an IdP
# (Keycloak or otherwise) is wired up.
CUSTOM_OIDC_ISSUER_URI=
# Only needed if the Gateway cannot reach CUSTOM_OIDC_ISSUER_URI directly
# from inside its container (split internal/external network view of the
# IdP - Docs/PRIAM-AUTH-OIDC.md §4).
CUSTOM_OIDC_JWK_SET_URI=
# Comma-separated list of allowed CORS origins, one per deployed
# human-facing frontend.
CUSTOM_FRONTEND_ORIGINS=http://localhost:4200,http://localhost:4000

# --- Keycloak admin bootstrap (only used if the `keycloak` service in
#     docker-compose.yml is started) ---
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Round-trip navigation (playbook §4ter) ---
# Browser-facing origin of the target application. Drives the "Back to the
# app" button on PRIAM-Frontend's Home page. Empty = button hidden. Point
# at a real, working page of your target application once integrated
# (not just its bare root URL).
TARGET_APP_URL=
