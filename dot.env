# Gateway resource server (see Docs/PRIAM-AUTH-OIDC.md). Any OIDC-compliant
# issuer works — the target application's own, or a broker (e.g. Keycloak)
# delegating to it. Left blank: human-facing routes (/right/**, /cdp/**) stay
# unauthenticated, which is fine for local machine-to-machine testing but not
# beyond it. Must be the address browsers/the frontend actually use — it has
# to match the `iss` claim Keycloak stamps on tokens.
# CUSTOM_OIDC_ISSUER_URI=http://localhost:8080/realms/priam-realm
CUSTOM_OIDC_ISSUER_URI=
# Only set this if the Gateway container can't reach CUSTOM_OIDC_ISSUER_URI
# directly (e.g. it's a host-published "localhost" address, unreachable from
# inside a container) — point it at the same Keycloak reached via the Docker
# network instead, just for fetching signing keys.
# CUSTOM_OIDC_JWK_SET_URI=http://keycloak:8080/realms/priam-realm/protocol/openid-connect/certs
CUSTOM_OIDC_JWK_SET_URI=

# Browser origin(s) PRIAM-Frontend is served from — needed for CORS on
# human-facing routes (/right/**, /cdp/**). Comma-separated for multiple.
CUSTOM_FRONTEND_ORIGINS=http://localhost:4200,http://localhost:4000

KEYCLOAK_URL=

KEYCLOAK_REALM=

KEYCLOAK_CLIENT_ID=

KEYCLOAK_CLIENT_SECRET=

GATEWAY_PORT=8090

